{
  "name": "relay-unity-orchestrator",
  "version": "0.3.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n WEB,CONTROL -c cyan,green \"cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 0.0.0.0\" \"node --env-file-if-exists=.env.local --watch server/index.mjs\"",
    "dev:web": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 0.0.0.0",
    "dev:server": "node --env-file-if-exists=.env.local --watch server/index.mjs",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "concurrently -k -n WEB,CONTROL -c cyan,green \"cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log node server/web.mjs\" \"node --env-file-if-exists=.env.local server/index.mjs\"",
    "start:web": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log node server/web.mjs",
    "start:server": "node --env-file-if-exists=.env.local server/index.mjs",
    "start:guardian": "node --env-file-if-exists=.env.local server/guardian.mjs",
    "test": "npm run test:server && npm run build && node --test tests/rendered-html.test.mjs",
    "test:server": "node --test tests/server/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
