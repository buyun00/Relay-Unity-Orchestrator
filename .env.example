# Relay only runs against the real host integrations.
PIPELINE_ADAPTER=hyperv
PIPELINE_HOST=0.0.0.0
PIPELINE_PORT=4317

# Keep browser access limited to the trusted LAN. Relay does not use a
# separate API access token; the browser name is recorded for attribution.
PIPELINE_ALLOWED_ORIGINS=http://localhost:3000

PIPELINE_DATA_DIR=C:\ProgramData\Relay\data
# One append-only JSONL audit file per local calendar day. It records the
# browser name, client IP, request metadata, and successfully delivered tasks.
PIPELINE_AUDIT_LOG_ENABLED=true
PIPELINE_AUDIT_LOG_DIR=C:\ProgramData\Relay\data\logs\daily-audit
PIPELINE_AUDIT_LOG_TIME_ZONE=Asia/Shanghai
PIPELINE_POWERSHELL_COMMAND=powershell.exe
PIPELINE_CODEX_COMMAND=codex
CODEX_HOME=C:\ProgramData\Relay\codex-home
PIPELINE_CODEX_MODEL=gpt-5.6-sol
PIPELINE_CODEX_REASONING_EFFORT=xhigh
PIPELINE_CODEX_SERVICE_TIER=default
PIPELINE_CODEX_TIMEOUT_MINUTES=90
PIPELINE_GIT_AUTHOR_NAME=Relay Unity Orchestrator
PIPELINE_GIT_AUTHOR_EMAIL=relay-unity-orchestrator@localhost
PIPELINE_GIT_COMMAND=git
# Comma-separated repository-relative paths for administrator-managed local
# overlays. A path is ignored only while Git still marks it skip-worktree.
PIPELINE_APPROVED_OVERLAY_PATHS=

# Project-management defect import. Tokens stay server-side and are persisted
# with Windows LocalMachine DPAPI encryption plus a restricted file ACL. The
# browser receives only private HttpOnly session/browser cookies. Upstream 401
# or an explicit logout removes the persisted token and returns to QR login.
PIPELINE_PROJECT_MANAGEMENT_ENABLED=true
PIPELINE_PROJECT_MANAGEMENT_BASE_URL=https://50qweb.jiaxianghudong.com
PIPELINE_PROJECT_MANAGEMENT_TIMEOUT_MS=10000
# Pending/unauthenticated QR sessions are discarded after this idle period.
# Authenticated sessions remain until upstream rejects the token or logout.
PIPELINE_PROJECT_MANAGEMENT_SESSION_HOURS=12
PIPELINE_PROJECT_MANAGEMENT_SESSION_STATE_PATH=C:\ProgramData\Relay\data\project-management-sessions.dpapi.json

# Strict task completion: Relay creates/reuses and immediately merges a GitLab
# MR, verifies and removes its task source branch, then updates linked
# project-management defects and closes the task.
# Store only the path here; the token itself is never copied into SQLite,
# browser responses, task events, or Relay logs.
PIPELINE_GITLAB_BASE_URL=http://git.dominogm.com
PIPELINE_GITLAB_TOKEN_FILE=E:\.env.txt
PIPELINE_GITLAB_TIMEOUT_MS=15000

# OZDQP Packer transaction outbox. The API key is optional and must remain in
# the private environment file; it is never persisted to SQLite or events.
OZDQP_BUILD_ENABLED=true
OZDQP_BUILD_API_URL=http://10.100.3.209:8088/api/v1/builds
OZDQP_BUILD_REPOSITORY_URL=http://git.dominogm.com/diaoyu/ozdqp.git
OZDQP_BUILD_API_KEY=
OZDQP_BUILD_TIMEOUT_MS=10000
OZDQP_BUILD_POLL_INTERVAL_MS=1000
OZDQP_BUILD_STATUS_POLL_INTERVAL_MS=5000
# A failed Packer attempt may be retried under the same job ID. Relay keeps
# checking failed jobs at this slower cadence so the UI can return to building.
OZDQP_BUILD_FAILED_STATUS_POLL_INTERVAL_MS=30000
OZDQP_BUILD_RETRY_SCHEDULE_MS=1000,2000,5000,10000,30000,60000
OZDQP_BUILD_RETRY_MAX_MS=300000

# Persistent system Codex, automatic incident handling, self-repair and
# validated Git deployment. Automated repair never accepts file deletions.
PIPELINE_OPS_ENABLED=true
PIPELINE_OPS_AUTO_HANDLE=true
PIPELINE_OPS_AUTO_DEPLOY=true
PIPELINE_OPS_MAX_ATTEMPTS=4
PIPELINE_OPS_MAX_CONCURRENT_SESSIONS=4
PIPELINE_OPS_CODEX_MODEL=gpt-5.6-sol
PIPELINE_OPS_CODEX_REASONING_EFFORT=xhigh
PIPELINE_OPS_CODEX_FAST_MODE=false

# Independent recovery plane. Relay and Guardian start each other after
# consecutive failed health checks.
PIPELINE_GUARDIAN_ENABLED=true
PIPELINE_GUARDIAN_HOST=0.0.0.0
PIPELINE_GUARDIAN_PORT=4318
PIPELINE_GUARDIAN_INTERVAL_MS=5000
PIPELINE_GUARDIAN_FAILURE_THRESHOLD=3
PIPELINE_GUARDIAN_RESTART_COOLDOWN_MS=20000
# Optional test/packaging overrides. Production uses these defaults.
PIPELINE_RELAY_ENTRY=server/index.mjs
PIPELINE_WEB_ENTRY=server/web.mjs

# Keep this false until PROJECT_READY checkpoints have been prepared.
PIPELINE_CHECKPOINTS_ENABLED=false
# Daily rolling refresh is run by Relay, not by a separate Scheduled Task.
# 05:00, 06:00, and 07:00 are retries for one local calendar day; a success
# suppresses the later retries. Keep exactly current + previous checkpoints.
PIPELINE_CHECKPOINT_MAINTENANCE_ENABLED=false
PIPELINE_CHECKPOINT_MAINTENANCE_HOURS=5,6,7
PIPELINE_CHECKPOINT_MAINTENANCE_TIME_ZONE=Asia/Shanghai
PIPELINE_CHECKPOINT_RETENTION_COUNT=2
PIPELINE_ALLOW_UNITY_SAVE_SKIP=false
PIPELINE_UNITY_GUEST_LOCAL_ENDPOINT=http://127.0.0.1:8090
