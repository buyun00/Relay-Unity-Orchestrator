# Relay only runs against the real host integrations.
PIPELINE_ADAPTER=hyperv
PIPELINE_HOST=0.0.0.0
PIPELINE_PORT=4317

# Keep browser access limited to the trusted LAN. Relay does not use a
# separate API access token; the browser name is recorded for attribution.
PIPELINE_ALLOWED_ORIGINS=http://localhost:3000

PIPELINE_DATA_DIR=C:\ProgramData\Relay\data
PIPELINE_POWERSHELL_COMMAND=powershell.exe
PIPELINE_CODEX_COMMAND=codex
CODEX_HOME=C:\ProgramData\Relay\codex-home
PIPELINE_CODEX_MODEL=gpt-5.6-sol
PIPELINE_CODEX_REASONING_EFFORT=xhigh
PIPELINE_CODEX_SERVICE_TIER=default
PIPELINE_CODEX_TIMEOUT_MINUTES=90
PIPELINE_GIT_AUTHOR_NAME=Relay Unity Orchestrator
PIPELINE_GIT_AUTHOR_EMAIL=relay-unity-orchestrator@localhost
PIPELINE_GIT_COMMAND=git

# OZDQP Packer transaction outbox. The API key is optional and must remain in
# the private environment file; it is never persisted to SQLite or events.
OZDQP_BUILD_ENABLED=true
OZDQP_BUILD_API_URL=http://10.100.3.209:8088/api/v1/builds
OZDQP_BUILD_REPOSITORY_URL=http://git.dominogm.com/diaoyu/ozdqp.git
OZDQP_BUILD_API_KEY=
OZDQP_BUILD_TIMEOUT_MS=10000
OZDQP_BUILD_POLL_INTERVAL_MS=1000
OZDQP_BUILD_RETRY_SCHEDULE_MS=1000,2000,5000,10000,30000,60000
OZDQP_BUILD_RETRY_MAX_MS=300000

# Persistent system Codex, automatic incident handling, self-repair and
# validated Git deployment. Automated repair never accepts file deletions.
PIPELINE_OPS_ENABLED=true
PIPELINE_OPS_AUTO_HANDLE=true
PIPELINE_OPS_AUTO_DEPLOY=true
PIPELINE_OPS_MAX_ATTEMPTS=4
PIPELINE_OPS_MAX_CONCURRENT_SESSIONS=4
PIPELINE_OPS_CODEX_MODEL=gpt-5.6-sol
PIPELINE_OPS_CODEX_REASONING_EFFORT=xhigh
PIPELINE_OPS_CODEX_FAST_MODE=false

# Independent recovery plane. Relay and Guardian start each other after
# consecutive failed health checks.
PIPELINE_GUARDIAN_ENABLED=true
PIPELINE_GUARDIAN_HOST=0.0.0.0
PIPELINE_GUARDIAN_PORT=4318
PIPELINE_GUARDIAN_INTERVAL_MS=5000
PIPELINE_GUARDIAN_FAILURE_THRESHOLD=3
PIPELINE_GUARDIAN_RESTART_COOLDOWN_MS=20000
# Optional test/packaging overrides. Production uses these defaults.
PIPELINE_RELAY_ENTRY=server/index.mjs
PIPELINE_WEB_ENTRY=server/web.mjs

# Keep this false until PROJECT_READY checkpoints have been prepared.
PIPELINE_CHECKPOINTS_ENABLED=false
PIPELINE_ALLOW_UNITY_SAVE_SKIP=false
PIPELINE_UNITY_GUEST_LOCAL_ENDPOINT=http://127.0.0.1:8090
